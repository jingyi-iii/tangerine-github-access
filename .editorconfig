root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

# cmd.exe mis-parses LF-only batch files, so these stay CRLF.
# See .gitattributes and tests/test_tangerine.py::TestRepositoryLineEndings.
[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{sh,bash}]
end_of_line = lf

[Makefile]
indent_style = tab
